# Discord Bot Configuration
# Required: Your Discord bot token
DISCORD_TOKEN=your_discord_bot_token_here

# Required: Your Discord Application ID
APP_ID=your_discord_application_id_here

# Optional: Reset database on startup (true/false)
# WARNING: This will delete all existing data!
RESET_DB=false

# Optional: Log format (text/json)
# Use "text" for human-readable logs, "json" for structured logging
LOG_FORMAT=json

# Optional: Environment (development/production)
# When set to "development", logs will use text format
ENV=production

# Optional: Google Gemini API Key for image generation
# Leave empty to disable image generation feature
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Poll threshold configuration
# Minimum number of suggestions needed to start a poll (default: 3)
MIN_SUGGESTIONS_TO_START_POLL=3
# Minimum number of "bd" reactions needed for a suggestion to qualify (default: 3)
MIN_UPDICKS_TO_QUALIFY=3
# Minimum number of cast ballots needed to end a poll (default: 5)
MIN_BALLOTS_TO_END_POLL=5
