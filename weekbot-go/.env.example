# Discord Bot Configuration
# Required: Your Discord bot token
DISCORD_TOKEN=your_discord_bot_token_here

# Required: Your Discord Application ID
APP_ID=your_discord_application_id_here

# Optional: Reset database on startup (true/false)
# WARNING: This will delete all existing data!
RESET_DB=false

# Optional: Log format (text/json)
# Use "text" for human-readable logs, "json" for structured logging
LOG_FORMAT=json

# Optional: Environment (development/production)
# When set to "development", logs will use text format
ENV=production
